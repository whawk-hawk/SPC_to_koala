<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SPC → KOALA | S-SMP Sample Extractor</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<style>
  :root{
    /* スーパーファミコン本体の配色 */
    --body:#c9c9d3;         /* 本体グレー */
    --panel:#dcdce3;        /* 明るいパネル */
    --panel-deep:#b3b3bf;   /* 沈んだグレー */
    --slot:#8e8e9c;         /* カセット挿入口 */
    --ink:#3a3a46;          /* 濃スレート文字 */
    --ink-soft:#6d6d7c;
    --sfc-red:#e6402a; --sfc-yellow:#f0a800; --sfc-green:#159a54; --sfc-blue:#1c6bb8;
    --wave:#2f2f3a;
    --radius:10px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{background:var(--body); color:var(--ink);
    font-family:-apple-system,"Hiragino Kaku Gothic ProN","Noto Sans JP",sans-serif;}
  .mono{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;}
  .wrap{max-width:760px; margin:0 auto; padding:20px 14px 80px;}

  /* ── ヘッダ: チップのシルク印刷風 ── */
  header{display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;
    border-bottom:3px solid var(--ink); padding-bottom:10px; margin-bottom:18px;}
  header h1{font-size:clamp(22px,5vw,30px); font-weight:800; letter-spacing:.04em;}
  header h1 .arrow{color:var(--sfc-red);}
  header .chiplabel{font-size:11px; letter-spacing:.22em; color:var(--ink-soft);
    text-transform:uppercase;}
  .btn-dots{display:inline-flex; gap:5px; margin-left:auto; align-self:center;}
  .btn-dots i{width:11px;height:11px;border-radius:50%;display:block;}
  .btn-dots i:nth-child(1){background:var(--sfc-red);}   .btn-dots i:nth-child(2){background:var(--sfc-yellow);}
  .btn-dots i:nth-child(3){background:var(--sfc-green);} .btn-dots i:nth-child(4){background:var(--sfc-blue);}

  /* ── ドロップゾーン: カセット挿入口 ── */
  #drop{position:relative; border-radius:var(--radius); background:var(--panel-deep);
    padding:26px 16px 22px; text-align:center; cursor:pointer;
    border:2px dashed transparent; transition:border-color .15s ease, background .15s ease;}
  #drop .slot{width:min(340px,80%); height:16px; margin:0 auto 14px; border-radius:4px;
