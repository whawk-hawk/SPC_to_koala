  .srow.dup{opacity:.45;}
  .lp{font-size:9.5px; font-weight:800; color:#fff; border-radius:4px; padding:2px 5px;}
  .lp.loop{background:var(--sfc-blue);} .lp.shot{background:var(--sfc-green);}

  /* ── ダウンロード ── */
  #dlsec{display:none; margin-top:26px; gap:10px; flex-wrap:wrap;}
  #dlsec.on{display:flex;}
  .big{border:0; border-radius:10px; padding:14px 22px; font-size:15px; font-weight:800;
    letter-spacing:.03em; cursor:pointer; color:#fff; box-shadow:0 3px 0 rgba(0,0,0,.25);}
  .big:active{transform:translateY(2px); box-shadow:0 1px 0 rgba(0,0,0,.25);}
  #dlkoala{background:var(--sfc-red); flex:1; min-width:220px;}
  #dlwav{background:var(--slot);}
  #note{display:none; margin-top:14px; font-size:11.5px; color:var(--ink-soft); line-height:1.7;}
  #err{display:none; margin-top:14px; background:#f3d7d2; border:2px solid var(--sfc-red);
    border-radius:8px; padding:10px 12px; font-size:13px;}
  @media (prefers-reduced-motion:reduce){ *{transition:none !important;} }
