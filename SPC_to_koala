    padding:12px 14px; font-size:12.5px; line-height:1.8;}
  #fileinfo .row{display:flex; gap:10px; flex-wrap:wrap;}
  #fileinfo .k{color:var(--ink-soft); letter-spacing:.08em; min-width:7em;}

  /* ── オプション ── */
  #opts{display:none; margin-top:14px; gap:10px; flex-wrap:wrap; align-items:center;}
  #opts.on{display:flex;}
  .seg{display:inline-flex; border:2px solid var(--ink); border-radius:8px; overflow:hidden;}
  .seg button{border:0; background:var(--panel); color:var(--ink); padding:7px 14px;
    font-size:12.5px; font-weight:700; cursor:pointer;}
  .seg button.on{background:var(--ink); color:var(--panel);}
  label.chk{display:inline-flex; align-items:center; gap:7px; font-size:12.5px; font-weight:600; cursor:pointer;}
  label.chk input{accent-color:var(--sfc-green); width:16px; height:16px;}

  /* ── パッドグリッド(署名要素) ── */
  #padsec{display:none; margin-top:22px;}
  #padsec h2, #listsec h2{font-size:12px; letter-spacing:.22em; color:var(--ink-soft);
    margin-bottom:10px; text-transform:uppercase;}
  #padgrid{display:grid; grid-template-columns:repeat(4,1fr); gap:8px;}
  .pad{position:relative; aspect-ratio:1; border-radius:12px; background:var(--panel);
    border:2px solid rgba(0,0,0,.14); cursor:pointer; overflow:hidden;
    display:flex; flex-direction:column; box-shadow:0 2px 0 rgba(0,0,0,.18);}
  .pad:active{transform:translateY(1px); box-shadow:0 1px 0 rgba(0,0,0,.18);}
  .pad.playing{outline:3px solid var(--ink);}
  .pad canvas{flex:1; width:100%; display:block;}
  .pad .tag{font-size:9.5px; font-weight:800; letter-spacing:.05em; text-align:center;
    padding:3px 2px 4px; color:#fff;}
  .pad.empty{background:var(--panel-deep); border-style:dashed; cursor:default; box-shadow:none;}
  .pad.empty .tag{color:var(--ink-soft); background:none !important;}

  /* ── サンプル一覧 ── */
  #listsec{display:none; margin-top:24px;}
  #cap{font-size:12px; color:var(--ink-soft); margin-bottom:8px;}
  #cap b{color:var(--ink);}
  .srow{display:flex; align-items:center; gap:10px; background:var(--panel);
    border-radius:8px; padding:7px 10px; margin-bottom:6px; font-size:12.5px;}
  .srow input{accent-color:var(--sfc-blue); width:16px; height:16px; flex:none;}
  .srow canvas{width:90px; height:26px; flex:none; background:#eceef0; border-radius:4px;}
  .srow .nm{font-weight:700; min-width:4.5em;}
  .srow .meta{color:var(--ink-soft);}
  .srow button{margin-left:auto; flex:none; border:2px solid var(--ink); background:var(--panel);
